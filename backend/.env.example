# ── 方式 A：使用 OpenAI（默认）──────────────────────────────
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=gpt-4o
# AI_BASE_URL=https://api.openai.com/v1   ← 默认值，可不填

# ── 方式 B：使用 Anthropic Claude ────────────────────────────
