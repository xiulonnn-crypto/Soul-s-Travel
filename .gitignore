# ================================
# Soul's Travel — 根目录 .gitignore
# 参考：github.com/github/gitignore
# ================================

# ─── 数据库 ──────────────────────
*.db
*.sqlite3
*.sqlite3-journal

# ─── Python ──────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
env/
ENV/

# 测试 & 覆盖率
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# 类型检查
.mypy_cache/
.dmypy.json
.pytype/
.pyre/

# Linter 缓存
.ruff_cache/

# Flask
instance/
.webassets-cache

# 打包产物
*.egg-info/
*.egg
dist/
build/
MANIFEST

# ─── Node / 前端 ──────────────────
# 依赖（前端子目录有独立 .gitignore，这里做兜底）
node_modules/
.npm
.pnpm-store
.pnp.*

# 构建产物
dist/
dist-ssr/

# Vite 运行时缓存
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ─── 环境变量 ─────────────────────
.env
.env.*
!.env.example

# ─── macOS ───────────────────────
.DS_Store
.localized
._*
__MACOSX/
.AppleDouble
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# ─── 编辑器 / IDE ─────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.sw?

# ─── 日志 ────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt

# ─── 设计临时文件 ───────────
design-temp/
